# Copy to .env and fill in. Never commit .env.

# Which LLM provider to use: mock | gemini | grok
# "mock" needs no API key and is used for local dev, tests, and CI (saves your free tokens).
LLM_PROVIDER=mock
GEMINI_API_KEY=
GROK_API_KEY=

# Database (docker-compose sets this automatically for the backend container)
DATABASE_URL=postgresql+asyncpg://rootsignal:rootsignal@localhost:5432/rootsignal

# Telemetry backends (wired in Phase 2)
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100

# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
