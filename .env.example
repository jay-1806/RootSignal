# Copy to .env and fill in. Never commit .env.

# --- LLM: mock | gemini | grok
# "mock" makes no LLM calls: the rule-based reasoner does everything. Free, and good for demos.
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GROK_API_KEY=
GROK_MODEL=grok-4.7
# If the primary LLM fails, try the other one (only if it has a key)
LLM_FALLBACK=true
# USD per 1M tokens, for cost tracking. Check the providers' pricing pages.
GEMINI_PRICE_INPUT=0
GEMINI_PRICE_OUTPUT=0
GROK_PRICE_INPUT=2.0
GROK_PRICE_OUTPUT=6.0

# --- Investigation engine
AUTOSTART=true
LOOKBACK_MINUTES=15
MAX_ITERATIONS=2
CONCLUDE_CONFIDENCE=0.7

# --- Storage (docker-compose sets DATABASE_URL for the backend container)
DATABASE_URL=postgresql+asyncpg://rootsignal:rootsignal@localhost:5432/rootsignal

# --- Data sources (docker-compose sets these for the backend container)
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
CHANGES_URL=http://localhost:8090

# --- API
CORS_ORIGINS=http://localhost:5173
# If set, alert webhooks must send "Authorization: Bearer <token>"
ALERT_WEBHOOK_TOKEN=

# Host port for Grafana (3000 is often used by other local dev servers)
GRAFANA_PORT=3001
